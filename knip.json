{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignore": [
    "website/**",
    "packages/stim-cli/shim/**",
    "scripts/agent-benchmark/compat/ps-bridge.mjs",
    "scripts/agent-benchmark/stamp.mjs",
    "scripts/agent-benchmark/watch-app.mjs"
  ],
  "workspaces": {
    ".": {
      "entry": ["apps/desktop/scripts/*.mjs"]
    },
    "apps/mobile": {
      "entry": ["plugins/*.js", "scripts/*.mjs", "mock-server/*.mjs", "fingerprint.config.js"],
      "ignoreBinaries": ["stim-server"],
      "ignoreDependencies": ["expo-screen-orientation", "@expo/fingerprint"],
      "ignoreExportsUsedInFile": {
        "interface": true,
        "type": true
      },
      "ignoreIssues": {
        "src/protocol/types.ts": ["types"]
      }
    }
  }
}
