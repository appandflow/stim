{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "singleQuote": true,
  "printWidth": 120,
  "ignorePatterns": [
    "**/dist/**",
    "**/node_modules/**",
    "website/build/**",
    "website/.docusaurus/**",
    "website/static/img/branding/*.json",
    ".claude/**",
    "apps/mobile/**",
    "apps/desktop/Support/Assets.xcassets/**",
    "apps/desktop/Tests/StimKitTests/Fixtures/oversight-vectors.json",
    "packages/core/receive-validators.mjs"
  ]
}
