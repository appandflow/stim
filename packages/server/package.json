{
  "name": "@stim-cli/server",
  "version": "1.40.0",
  "private": true,
  "description": "Serves Stim status to paired clients over Tailscale, and runs reload and stop for clients granted control.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/appandflow/stim.git",
    "directory": "packages/server"
  },
  "bin": {
    "stim-server": "dist/stim-server.mjs"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "main": "dist/protocol.mjs",
  "types": "dist/protocol.d.mts",
  "exports": {
    ".": {
      "types": "./dist/protocol.d.mts",
      "module-sync": "./dist/protocol.mjs",
      "default": "./dist/protocol.mjs"
    },
    "./protocol.schema.json": "./dist/protocol.schema.json",
    "./hosted-relay": {
      "types": "./dist/hosted-relay.d.mts",
      "module-sync": "./dist/hosted-relay.mjs",
      "default": "./dist/hosted-relay.mjs"
    },
    "./cli": {
      "types": "./dist/cli.d.mts",
      "module-sync": "./dist/cli.mjs",
      "default": "./dist/cli.mjs"
    },
    "./build": {
      "types": "./dist/build.d.mts",
      "module-sync": "./dist/build.mjs",
      "default": "./dist/build.mjs"
    },
    "./environment": {
      "types": "./dist/environment.d.mts",
      "module-sync": "./dist/environment.mjs",
      "default": "./dist/environment.mjs"
    },
    "./release-install": {
      "types": "./dist/release-install.d.mts",
      "module-sync": "./dist/release-install.mjs",
      "default": "./dist/release-install.mjs"
    },
    "./service-plist": {
      "types": "./dist/service-plist.d.mts",
      "module-sync": "./dist/service-plist.mjs",
      "default": "./dist/service-plist.mjs"
    }
  },
  "scripts": {
    "build": "tsdown"
  },
  "dependencies": {
    "@stim-cli/agent-driver": "workspace:*",
    "@stim-cli/agent-driver-agent-device": "workspace:*",
    "@stim-cli/core": "workspace:*",
    "@stim-cli/transport": "workspace:*",
    "@stim-cli/transport-local": "workspace:*",
    "@stim-cli/transport-tailscale": "workspace:*",
    "stim": "workspace:*",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/ws": "^8.18.1"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
