{
  "name": "stim",
  "version": "1.7.0",
  "description": "Stim: fast, isolated React Native environments for coding agents",
  "keywords": [
    "agent",
    "emulator",
    "expo",
    "metro",
    "react-native",
    "simulator",
    "worktree"
  ],
  "homepage": "https://github.com/appandflow/stim#readme",
  "bugs": {
    "url": "https://github.com/appandflow/stim/issues"
  },
  "license": "MIT",
  "author": "Janic Duplessis",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/appandflow/stim.git",
    "directory": "packages/stim-cli"
  },
  "bin": {
    "stim": "dist/cli.mjs"
  },
  "files": [
    "dist",
    "shim",
    "skill",
    "LICENSE",
