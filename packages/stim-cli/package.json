      "module-sync": "./dist/api-self.mjs",
      "default": "./dist/api-self.mjs"
    },
    "./engine-state": {
      "types": "./dist/engine-state.d.mts",
      "module-sync": "./dist/engine-state.mjs",
      "default": "./dist/engine-state.mjs"
    },
    "./cache-manifest": {
      "types": "./dist/cache-manifest.d.mts",
      "module-sync": "./dist/cache-manifest.mjs",
      "default": "./dist/cache-manifest.mjs"
    },
    "./pull-requests": {
      "types": "./dist/pull-requests.d.mts",
      "module-sync": "./dist/pull-requests.mjs",
      "default": "./dist/pull-requests.mjs"
    },
    "./share-links": {
      "types": "./dist/share-links.d.mts",
      "module-sync": "./dist/share-links.mjs",
      "default": "./dist/share-links.mjs"
    },
    "./attached-stimd": {
      "types": "./dist/attached-stimd.d.mts",
