{
  "name": "stim",
  "version": "1.40.0",
  "description": "Stim: fast, isolated React Native environments for coding agents",
  "keywords": [
    "agent",
    "emulator",
    "expo",
    "metro",
    "react-native",
    "simulator",
    "worktree"
  ],
  "homepage": "https://github.com/appandflow/stim#readme",
  "bugs": {
    "url": "https://github.com/appandflow/stim/issues"
  },
  "license": "MIT",
  "author": "Janic Duplessis",
  "repository": {
