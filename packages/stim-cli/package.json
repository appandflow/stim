      "types": "./dist/ci.d.mts",
      "module-sync": "./dist/ci.mjs",
      "default": "./dist/ci.mjs"
    },
    "./ci/artifacts": {
      "types": "./dist/ci/artifacts.d.mts",
      "module-sync": "./dist/ci/artifacts.mjs",
      "default": "./dist/ci/artifacts.mjs"
    },
    "./plugin": {
      "types": "./dist/plugin.d.mts",
      "module-sync": "./dist/plugin.mjs",
      "default": "./dist/plugin.mjs"
    }
