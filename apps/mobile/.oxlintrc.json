{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "react", "import", "oxc", "unicorn"],
  "jsPlugins": ["eslint-plugin-expo", "eslint-plugin-lingui"],
  "categories": {
    "correctness": "error"
  },
  "env": {
    "builtin": true,
    "browser": true,
    "es2022": true
  },
  "globals": {
    "__DEV__": "readonly"
  },
  "ignorePatterns": ["node_modules/**", "ios/**", "android/**", ".expo/**", "dist/**", "locales/**"],
  "rules": {
    "eqeqeq": ["warn", "smart"],
    "no-empty-character-class": "warn",
    "no-empty-pattern": "warn",
    "no-extend-native": "warn",
    "no-extra-bind": "warn",
    "no-redeclare": "warn",
    "no-unreachable": "warn",
    "no-unsafe-negation": "warn",
    "no-unused-expressions": [
      "warn",
      {
        "allowShortCircuit": true,
        "enforceForJSX": true
      }
    ],
    "no-unused-labels": "warn",
    "no-unused-vars": [
      "warn",
      {
        "vars": "all",
        "args": "none",
        "ignoreRestSiblings": true,
        "caughtErrors": "all",
        "caughtErrorsIgnorePattern": "^_"
      }
    ],
    "no-useless-constructor": "warn",
    "no-var": "error",
    "no-with": "warn",
    "unicode-bom": ["warn", "never"],
    "use-isnan": "error",
    "valid-typeof": "error",
    "import/default": "off",
    "import/export": "error",
    "import/first": "warn",
    "import/named": "error",
    "import/namespace": "error",
    "typescript/array-type": [
      "warn",
      {
        "default": "array"
      }
    ],
    "typescript/consistent-type-assertions": [
      "warn",
      {
        "assertionStyle": "as",
        "objectLiteralTypeAssertions": "allow"
      }
    ],
    "typescript/no-empty-object-type": "warn",
    "typescript/no-extra-non-null-assertion": "warn",
    "typescript/no-wrapper-object-types": "warn",
    "react/display-name": "warn",
    "react/jsx-key": "error",
    "react/jsx-no-comment-textnodes": "error",
    "react/jsx-no-duplicate-props": "error",
    "react/jsx-no-undef": "error",
    "react/no-children-prop": "error",
    "react/no-danger-with-children": "error",
    "react/no-direct-mutation-state": "error",
    "react/no-find-dom-node": "error",
    "react/no-is-mounted": "error",
    "react/no-render-return-value": "error",
    "react/no-string-refs": "error",
    "react/no-this-in-sfc": "warn",
    "react/no-unescaped-entities": "error",
    "react/no-unknown-property": "warn",
    "react/react-in-jsx-scope": "off",
    "react/require-render-return": "error",
    "react/rules-of-hooks": "error",
    "react/exhaustive-deps": "warn",
    "react/error-boundaries": "error",
    "react/globals": "error",
    "react/immutability": "error",
    "react/incompatible-library": "error",
    "react/preserve-manual-memoization": "error",
    "react/purity": "error",
    "react/refs": "error",
    "react/set-state-in-effect": "error",
    "react/set-state-in-render": "error",
    "react/static-components": "error",
    "react/unsupported-syntax": "error",
    "react/use-memo": "error",
    "react/void-use-memo": "error",
    "react/todo": "error",
    "react/syntax": "error",
    "react/invariant": "error",
    "react/rule-suppression": "error",
    "expo/no-dynamic-env-var": "error",
    "expo/no-env-var-destructuring": "error",
    "expo/use-dom-exports": "error",
    "lingui/no-expression-in-message": "error",
    "lingui/no-single-tag-to-translate": "error",
    "lingui/no-single-variables-to-translate": "error",
    "lingui/no-trans-inside-trans": "error",
    "lingui/t-call-in-function": "error"
  },
  "overrides": [
    {
      "files": ["src/**/*.ts", "src/**/*.tsx"],
      "rules": {
        "lingui/no-unlocalized-strings": [
          "error",
          {
            "ignore": ["^(?![A-Z])\\S+$", "^(stim|stim-server|cd|at) "],
            "ignoreNames": [
              {
                "regex": {
                  "pattern": "^(variant|tone|weight|feedback|placement|iconRenderingMode|ellipsizeMode|returnKeyType|keyExtractor|name|icon|key|size|testID)$"
                }
              },
              { "regex": { "pattern": "([Ss]tyle|Color|[Ss]hadow|Image|^command|^remedy|^[A-Z][A-Z0-9_]*)$" } }
            ],
            "ignoreFunctions": [
              "require",
              "console.*",
              "Error",
              "*.join",
              "*.includes",
              "*.startsWith",
              "*.endsWith",
              "Date.parse"
            ]
          }
        ]
      }
    },
    {
      "files": ["**/*.ts", "**/*.tsx"],
      "rules": {
        "typescript/no-require-imports": [
          "warn",
          {
            "allow": [
              "\\.(aac|aiff|avif|bmp|caf|db|gif|heic|html|jpeg|jpg|json|m4a|m4v|mov|mp3|mp4|mpeg|mpg|otf|pdf|png|psd|svg|ttf|wav|webm|webp|xml|yaml|yml|zip)$"
            ]
          }
        ]
      }
    },
    {
      "files": [
        "**/*.test.ts",
        "**/*.test.tsx",
        "src/design/**",
        "src/lib/agent-prompts.ts",
        "src/lib/oversight.ts",
        "src/screens/gallery.tsx",
        "src/components/icon.tsx",
        "src/components/agent-icon.tsx",
        "src/components/platform-glyph.tsx",
        "src/components/platform-logo.tsx"
      ],
      "rules": { "lingui/no-unlocalized-strings": "off" }
    },
    {
      "files": ["**/*.js", "**/*.mjs", "**/*.cjs", "app.config.ts", "scripts/**", "mock-server/**", "plugins/**"],
      "env": {
        "node": true
      }
    },
    {
      "files": ["**/*.js", "**/*.mjs", "**/*.cjs"],
      "rules": {
        "no-undef": "error"
      }
    }
  ]
}
