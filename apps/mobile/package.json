{
  "name": "stim-mobile",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "mock-server": "node mock-server/server.mjs",
    "licenses": "node scripts/generate-licenses.mjs",
    "licenses:check": "node scripts/generate-licenses.mjs --check",
    "dev:pair": "node scripts/dev-pair.mjs",
    "lint": "oxlint --deny-warnings --report-unused-disable-directives-severity=error && node scripts/check-ascii.mjs",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "intl:extract": "lingui extract --clean",
    "intl:compile": "lingui compile",
    "intl:check": "pnpm run intl:extract && pnpm run intl:compile && git diff --exit-code -- locales",
    "eas-build-post-install": "pnpm --filter @stim-cli/core run build"
  },
  "dependencies": {
    "@expo/ui": "~58.0.7",
    "@formatjs/intl-locale": "5.3.12",
    "@formatjs/intl-pluralrules": "6.3.15",
    "@lingui/core": "5.9.5",
    "@lingui/react": "5.9.5",
    "@sentry/react-native": "8.28.0",
    "@stim-cli/core": "workspace:^",
    "expo": "~58.0.0-preview.7",
    "expo-camera": "~58.0.3",
    "expo-clipboard": "~58.0.1",
    "expo-constants": "~58.0.7",
    "expo-dev-client": "~58.0.7",
    "expo-haptics": "~58.0.4",
    "expo-image": "~58.0.6",
    "expo-linking": "~58.0.7",
    "expo-navigation-bar": "~58.0.1",
    "expo-notifications": "~58.0.7",
    "expo-router": "~58.0.8",
    "expo-screen-orientation": "~58.0.0",
    "expo-secure-store": "~58.0.0",
    "expo-splash-screen": "~58.0.1",
    "expo-status-bar": "~58.0.1",
    "expo-system-ui": "~58.0.2",
    "expo-updates": "~58.0.9",
    "lottie-react-native": "~7.5.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0-rc.1",
    "react-native-drawer-layout": "^4.2.10",
    "react-native-ease": "0.8.0",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-hinges": "0.1.0-alpha.3",
    "react-native-mmkv": "4.3.2",
    "react-native-nitro-modules": "0.37.1",
    "react-native-reanimated": "4.7.0",
    "react-native-reserved-regions": "0.2.0",
    "react-native-safe-area-context": "~5.9.1",
    "react-native-screens": "~4.28.0",
    "react-native-transformer-text-input": "0.4.2",
    "react-native-unistyles": "3.4.0",
    "react-native-worklets": "0.13.0",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@lingui/babel-plugin-lingui-macro": "5.9.5",
    "@lingui/cli": "5.9.5",
    "@lingui/format-po": "5.9.5",
    "@react-native/metro-config": "0.88.0-rc.1",
    "@testing-library/react-native": "14.0.1",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.3.0",
    "@types/ws": "^8.18.1",
    "babel-jest": "29.7.0",
    "babel-preset-expo": "~58.0.4",
    "eslint-plugin-expo": "^1.2.0",
    "eslint-plugin-lingui": "0.16.0",
    "jest": "~29.7.0",
    "jest-expo": "~58.0.3",
    "oxfmt": "0.65.0",
    "oxlint": "1.80.0",
    "sf-symbols-typescript": "2.2.0",
    "sharp": "^0.35.4",
    "test-renderer": "^1.3.0",
    "typescript": "7.0.2",
    "ws": "^8.21.3"
  },
  "jest": {
    "moduleNameMapper": {
      "^@/assets/(.*)$": "<rootDir>/assets/$1"
    },
    "preset": "jest-expo",
    "setupFiles": [
      "<rootDir>/src/intl/i18n.ts"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/mock-server/"
    ],
    "transform": {
      "\\.mjs$": [
        "babel-jest",
        {
          "presets": [
            "babel-preset-expo"
          ]
        }
      ]
    },
    "transformIgnorePatterns": [
      "/node_modules/(?!(.pnpm|react-native|@react-native|@react-native-community|expo|@expo|@expo-google-fonts|react-navigation|@react-navigation|@sentry|native-base|standard-navigation))",
      "/node_modules/react-native-reanimated/plugin/",
      "/node_modules/@react-native/babel-preset/"
    ]
  },
  "expo": {
    "autolinking": {
      "ios": {
        "buildFromSource": [
          "expo-image"
        ]
      }
    }
  }
}
