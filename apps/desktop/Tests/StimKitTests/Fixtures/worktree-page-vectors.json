        "path": "/w/one/apps/mobile",
        "environments": [
          {
            "path": "/w/one/apps/mobile",
            "live": true,
            "warnings": [],
            "worktree": {
              "path": "/w/one"
            },
            "stage": {
              "kind": "running",
              "since": "2026-10-05T11:00:00.000Z",
              "platform": null,
              "closedApps": []
            }
          }
        ],
        "entries": [
          {
            "path": "/w/one/apps/mobile",
            "platform": "ios"
          },
          {
            "path": "/w/one/apps/mobile",
            "platform": "android"
          }
        ]
      },
      "expected": {
        "apps": ["/w/one/apps/mobile"],
        "projects": ["apps/mobile"],
        "lead": "/w/one/apps/mobile",
        "subtitles": [null, null],
        "appLabels": ["iOS \u00b7 Android"]
      }
    },
