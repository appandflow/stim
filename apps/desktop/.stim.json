{
  "macos": {
    "product": "StimDesktop",
    "infoPlist": "Support/Info-Development.plist",
    "arguments": [
      "-autopilot.idleShutdown",
      "NO",
      "-autopilot.nightly",
      "NO",
      "-autopilot.pressure",
      "NO",
      "-autopilot.pullRequests",
