      "stim-jar-dark.json": "../../website/static/img/branding/stim-jar-dark.json",
      "stim-jar-light.json": "../../website/static/img/branding/stim-jar-light.json",
      "wordmark.svg": "../../website/static/img/branding/wordmark.svg",
      "agent-claude.svg": "../../website/static/img/branding/agent-claude.svg",
      "agent-codex.svg": "../../website/static/img/branding/agent-codex.svg",
      "agent-cursor.svg": "../../website/static/img/branding/agent-cursor.svg",
      "xcbeautify-LICENSE.txt": "Support/xcbeautify-LICENSE.txt",
