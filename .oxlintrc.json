{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "import", "node", "promise", "vitest"],
  "jsPlugins": ["./scripts/oxlint/stim.mjs"],
  "options": {
    "denyWarnings": true,
    "reportUnusedDisableDirectives": "error"
  },
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "env": {
    "builtin": true,
    "node": true,
    "es2023": true
  },
  "ignorePatterns": [
    "website/build/**",
    "website/.docusaurus/**",
    "apps/mobile/**",
    "packages/core/receive-validators.mjs",
    ".github/actions/stim-ci/dist/**"
  ],
  "rules": {
    "complexity": [
      "error",
      {
        "max": 80
      }
    ],
    "no-unused-vars": "warn",
    "no-warning-comments": ["error", { "terms": ["todo", "fixme", "hack", "xxx"] }],
    "stim/directive-reason": "error",
    "stim/no-snapshot": "error",
    "typescript/ban-ts-comment": "error",
    "typescript/no-explicit-any": "error",
    "vitest/no-commented-out-tests": "off",
    "no-underscore-dangle": [
      "warn",
      {
        "allow": ["_load", "_resolveFilename", "_root", "__path"]
      }
    ],
    "import/export": "error",
    "import/named": "error",
    "import/no-cycle": "error",
    "import/no-duplicates": "error",
    "node/no-exports-assign": "error",
    "node/no-new-require": "error",
    "node/no-path-concat": "error",
    "oxc/no-map-spread": "warn",
    "promise/no-return-in-finally": "error",
    "promise/no-return-wrap": "error",
    "unicorn/prefer-array-find": "warn",
    "unicorn/require-post-message-target-origin": "off"
  },
  "overrides": [
    {
      "files": ["packages/core/**/*.{ts,mts,mjs,js}"],
      "excludeFiles": ["**/__tests__/**", "**/*.test.*", "**/tsdown.config.*"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "regex": "^@stim-cli/(?!(?:core)(?:/|$))|^stim(?:/|$)"
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["packages/cache/**/*.{ts,mts,mjs,js}"],
      "excludeFiles": ["**/__tests__/**", "**/*.test.*", "**/tsdown.config.*"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "regex": "^@stim-cli/(?!(?:cache|core)(?:/|$))|^stim(?:/|$)"
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["packages/ci/**/*.{ts,mts,mjs,js}"],
      "excludeFiles": ["**/__tests__/**", "**/*.test.*", "**/tsdown.config.*"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "regex": "^@stim-cli/(?!(?:ci)(?:/|$))|^stim/(?!(?:package\\.json|cache-manifest|pull-requests|share-links|build-artifact-cache|ci|ci/artifacts)$)"
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["packages/server/**/*.{ts,mts,mjs,js}"],
      "excludeFiles": ["**/__tests__/**", "**/*.test.*", "**/tsdown.config.*"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "regex": "^@stim-cli/(?!(?:server|agent-driver|agent-driver-agent-device|core|transport|transport-local|transport-tailscale)(?:/|$))|^stim/(?!(?:package\\.json|cache-manifest|pull-requests|share-links|build-artifact-cache|ci|ci/artifacts)$)"
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["packages/server/**/*.{ts,mts,mjs,js}"],
      "excludeFiles": ["**/__tests__/**", "**/*.test.*", "**/tsdown.config.*"],
      "rules": {
        "stim/static-imports": [
          "error",
          { "modules": ["@stim-cli/transport-tailscale", "@stim-cli/agent-driver-agent-device"] }
        ]
      }
    },
    {
      "files": ["packages/stim-cli/src/**/*.{ts,mts,mjs,js}"],
      "excludeFiles": ["**/__tests__/**", "**/*.test.*"],
      "rules": {
        "stim/static-imports": [
          "error",
          {
            "modules": ["@stim-cli/agent-driver-agent-device"],
            "allow": ["@stim-cli/agent-driver-agent-device/agent-device-bin"]
          }
        ]
      }
