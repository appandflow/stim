                "regex": "^@stim-cli/(?:cache|cache-s3|ci|core|server|transport|transport-local|transport-tailscale)(?:/|$)|^stim(?:/|$)|^unique-pid(?:/|$)",
                "message": "A driver reaches the engine only through the agent-driver contract and its host members."
              },
              {
                "regex": "^@stim-cli/agent-driver(?:/|$)",
                "allowTypeImports": true,
                "message": "A driver reaches the engine only through the agent-driver contract; import its types only."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["packages/**/*.{ts,tsx,mts,mjs,js,cjs,cts}"],
      "excludeFiles": ["**/__tests__/**", "**/*.test.*", "packages/stim-cli/tsdown.config.ts"],
      "rules": {
        "stim/package-fence": "error"
      }
    },
    {
      "files": ["packages/stim-cli/src/**/*.ts"],
      "excludeFiles": ["packages/stim-cli/src/exec.ts", "packages/stim-cli/src/__tests__/**", "**/*.test.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "node:child_process",
                "allowTypeImports": true,
                "message": "Start child processes through getExecutor() in exec.ts."
              },
              {
                "name": "child_process",
                "allowTypeImports": true,
                "message": "Start child processes through getExecutor() in exec.ts."
              },
              {
                "name": "cross-spawn",
                "message": "Start child processes through getExecutor() in exec.ts."
              },
              {
                "name": "@stim-cli/core",
                "importNames": ["ambientContext", "ambientEnv", "withAmbientContext", "ambientWrite"],
                "message": "Take a StimContext parameter; the ambient context is a temporary bridge for code not migrated yet."
              }
            ]
          }
        ],
        "no-restricted-properties": [
          "error",
          {
            "object": "process",
            "property": "env",
            "message": "Read the environment from the StimContext."
          },
          {
            "object": "process",
            "property": "cwd",
            "message": "Read the working directory from the StimContext."
          },
          {
            "object": "process",
            "property": "chdir",
            "message": "Operations never change the process working directory."
          },
          {
            "object": "process",
            "property": "exit",
            "message": "Return a failure; only CLI entries end the process."
          },
          {
            "object": "process",
            "property": "exitCode",
            "message": "Return a failure; only CLI entries set the exit code."
          },
          {
            "object": "process",
            "property": "on",
            "message": "Only CLI and detached entries install process listeners."
          },
          {
            "object": "process",
            "property": "once",
            "message": "Only CLI and detached entries install process listeners."
          },
          {
            "object": "process",
            "property": "off",
            "message": "Only CLI and detached entries install process listeners."
          },
          {
            "object": "process",
            "property": "stdout",
            "message": "Write through the StimContext output."
          },
          {
            "object": "process",
            "property": "stderr",
            "message": "Write through the StimContext output."
          }
        ],
        "no-console": "error"
      }
    },
